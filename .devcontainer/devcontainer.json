{
  "name": "yass-nekobox-plugin",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": "false",
      "installMaven": "false"
    }
  },
  "postCreateCommand": ".devcontainer/setup-android-sdk.sh",
  "remoteEnv": {
    "ANDROID_HOME": "${containerEnv:HOME}/android-sdk",
    "ANDROID_SDK_ROOT": "${containerEnv:HOME}/android-sdk"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
